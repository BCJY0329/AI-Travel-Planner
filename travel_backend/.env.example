# Copy to .env in travel_backend only if .env does not already exist.
# Fill in keys privately in .env; never put real keys in this template.
# Start the backend from travel_backend (config.py loads .env relative to cwd).
# Restart the backend after changing settings. Process environment variables
# override .env values. Blank keys leave the corresponding service unconfigured.

# Weather AND city geocoding (also needed for hotel/attraction city searches).
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# Hotel locations and attractions; no hotel pricing/ratings/amenities.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com

# Flights: use your Duffel test key for sandbox data.
DUFFEL_API_KEY=
DUFFEL_BASE_URL=https://api.duffel.com

# Lemon LLM providers: configure whichever providers you intend to use.
# Models below mirror config.py defaults, not verified account availability.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Provider selection is in the request's provider field, not an env setting:
# auto, groq, gemini, openrouter, mock.
# auto tries Groq -> Gemini -> OpenRouter, then local fallback.
# mock chat needs no keys; mock plans still attempt external context lookups.
# New providers require code integration as well as keys. See README.md,
# "Adding or changing providers". Do not add undeclared variables to .env:
# the current Settings configuration rejects extra dotenv fields.
